# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key: SOLO se usa en el servidor (rutas /api). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Secreto para firmar la cookie de sesión admin (openssl rand -hex 32)
ADMIN_SECRET=8f2c...64-caracteres-aleatorios

# Los administradores viven en la tabla public.admins (supabase/admins.sql),
# no en una variable de entorno. Crea el primero con:
#   select public.crear_admin('tu-usuario', 'tu-clave', 'Tu Nombre');

# Mapbox: capas Calles, Satélite y Claro de los mapas. Es un token público
# (pk.), pero conviene restringirlo por dominio en account.mapbox.com. Sin él,
# el selector de capas ofrece OpenStreetMap y MapLibre.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# Athena: módulo de Auditoría. Solo servidor, nunca con prefijo NEXT_PUBLIC_.
# Van con ATHENA_ y no con AWS_ porque Vercel reserva los nombres AWS_*.
ATHENA_ACCESS_KEY_ID=AKIA...
ATHENA_SECRET_ACCESS_KEY=...
# Opcionales: estos son los valores por defecto.
# ATHENA_REGION=us-east-1
# ATHENA_WORKGROUP=workgroup647
# ATHENA_DATABASE=livetradebi
# ATHENA_OUTPUT=s3://mkt-bi-athena-read-cliente-id-647/athena/
# Minutos en que se reutiliza el resultado de una consulta reciente (0 = nunca).
# ATHENA_REUSO_MINUTOS=10

# Asistente IA: Groq (principal), Gemini (secundaria) y GPT-4o por OpenRouter (respaldo).
# Solo servidor, nunca con prefijo NEXT_PUBLIC_.
# Groq: console.groq.com → API Keys (empieza por gsk_). Gemini: aistudio.google.com → Get API key.
# OpenRouter: openrouter.ai/keys (empieza por sk-or-v1-); se paga por uso con saldo de la cuenta.
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...
# Opcionales: estos son los valores por defecto.
# GROQ_MODELO=openai/gpt-oss-120b
# Con imágenes se usa este (el único de Groq que ve imágenes):
# GROQ_MODELO_VISION=qwen/qwen3.8-27b
# Cuánto razona gpt-oss antes de responder: low, medium o high (más lento y gasta más tokens).
# GROQ_ESFUERZO=low
# Tope de tokens por respuesta de Groq. El plan gratis tiene un límite de tokens por minuto.
# GROQ_MAX_TOKENS=4096
# GEMINI_MODELO_CHAT=gemini-3.8-flash
# Gemini rota solo entre los modelos de la cuenta cuando uno agota su cupo.
# Para fijar la lista a mano, en orden (con uno solo, no rota):
# GEMINI_MODELOS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
# OPENROUTER_MODELO=openai/gpt-4o
# Tope de tokens por respuesta de GPT-4o (cada token se paga).
# OPENROUTER_MAX_TOKENS=4096
# Opcional: la dirección del panel, para las estadísticas de OpenRouter (HTTP-Referer).
# OPENROUTER_SITIO=https://tu-panel.vercel.app
